{
  "name": "lom",
  "private": true,
  "type": "module",
  "description": "League of Managers \u2014 collect player-season cards, open a pack a day.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "catalogue:build": "node scripts/build-catalogue.mjs",
    "catalogue:push": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/push-catalogue.mjs",
    "ingest": "node scripts/ingest-leaguepedia.mjs",
    "cards:demo": "node packages/card-engine/build-demo.mjs",
    "cards:pack": "node packages/card-engine/build-demo.mjs --pack",
    "catalogue:seed": "node scripts/build-seed-catalogue.mjs",
    "sim:match": "node packages/sim/cli.mjs",
    "sim:balance": "node packages/sim/balance.mjs",
    "sim:test": "node --test packages/sim/test/*.test.mjs"
  },
  "dependencies": {
    "@nuxtjs/supabase": "2.1.0",
    "@supabase/supabase-js": "2.119.1",
    "nuxt": "4.6.4"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
